# --- Database & cache ---
DATABASE_URL=postgresql+asyncpg://animal_chess:animal_chess@localhost:5432/animal_chess
REDIS_URL=redis://localhost:6379/0

# --- Auth (MUST match apps/web exactly) ---
# Python decodes the NextAuth v4 session JWT (encrypted JWE) with this shared secret.
NEXTAUTH_SECRET=

# --- Internal Node <-> Python sync (MUST match apps/web) ---
# Guards the /internal/graphql schema (HMAC of the request body).
INTERNAL_SYNC_SECRET=

# --- Web origin for CORS allowlist + the Node room-snapshot reconciliation endpoint ---
WEB_ORIGIN=http://localhost:3000
NODE_SNAPSHOT_URL=http://localhost:3000/internal/rooms/snapshot

# --- Misc ---
PORT=8000
ENVIRONMENT=development
# IANA tz used for daily-login / daily-quest reset boundaries.
DAILY_TZ=Asia/Ho_Chi_Minh

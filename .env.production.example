# Domain served by Caddy. Use a real domain for automatic HTTPS, e.g. chess.example.com.
# For first IP-only smoke tests, you can use DOMAIN=:80 and APP_ORIGIN=http://YOUR_SERVER_IP.
DOMAIN=chess.example.com

APP_ORIGIN=https://chess.example.com
NEXTAUTH_URL=https://chess.example.com
NEXT_PUBLIC_API_URL=https://chess.example.com

# Optional: Google login. Guests still work when these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate both with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
INTERNAL_SYNC_SECRET=change-me-too

# Internal Postgres credentials used only inside the Docker network.
POSTGRES_USER=animal_chess
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=animal_chess

DAILY_TZ=Asia/Ho_Chi_Minh
ENVIRONMENT=production

{
  "name": "animal-chess",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@animal-chess/web",
    "dev:api": "pnpm --filter @animal-chess/api dev",
    "dev:infra": "docker compose up -d db redis",
    "build": "turbo run build",
    "start": "pnpm --filter @animal-chess/web start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "migrate": "pnpm --filter @animal-chess/api migrate",
    "seed": "pnpm --filter @animal-chess/api seed",
    "schema:export": "pnpm --filter @animal-chess/api schema:export",
    "codegen": "pnpm --filter @animal-chess/social-protocol codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "turbo": "^2.5.0"
  }
}

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Python GraphQL backend (services/api): users, friends, rank, gamification ---
# Public (inlined into the client bundle): where the browser reaches GraphQL over HTTP + WS.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only: the Node game server posts internal GraphQL mutations (match results, lobby) here.
PYTHON_SYNC_URL=http://localhost:8000
# Shared secret guarding those internal calls (MUST match services/api INTERNAL_SYNC_SECRET).
INTERNAL_SYNC_SECRET=

# --- SEO/GEO ---
# Canonical origin used for metadata, JSON-LD, sitemap.xml and robots.txt.
# Defaults to the production domain; override for a preview deployment.
NEXT_PUBLIC_SITE_URL=https://chess.u3ih.io.vn
